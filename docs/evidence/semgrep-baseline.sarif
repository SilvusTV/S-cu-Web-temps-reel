{"version":"2.1.0","runs":[{"invocations":[{"executionSuccessful":true,"toolExecutionNotifications":[]}],"results":[{"fingerprints":{"matchBasedId/v1":"requires login"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"tmp/baseline/front.js","uriBaseId":"%SRCROOT%"},"region":{"endColumn":19,"endLine":37,"snippet":{"text":"      carte.innerHTML =\n        zones.map((z) => {\n          const x = X(z.bbox[2]), y = Y(z.bbox[1]), w = X(z.bbox[3]) - x, h = Y(z.bbox[0]) - y\n          return `<rect class=\"zone\" x=\"${x}\" y=\"${y}\" width=\"${w}\" height=\"${h}\"/>\n                  <text class=\"label\" x=\"${x+4}\" y=\"${y+14}\">${z.nom}</text>`\n        }).join('') +\n        shown.map((l) =>\n          `<circle class=\"livreur\" cx=\"${X(l.position.lon)}\" cy=\"${Y(l.position.lat)}\" r=\"6\"/>\n           <text class=\"label\" x=\"${X(l.position.lon)+8}\" y=\"${Y(l.position.lat)}\">${l.nom} (${l.zone ?? 'hors zone'})</text>`\n        ).join('')"},"startColumn":7,"startLine":28}}}],"message":{"text":"Construire le DOM avec textContent ; éviter les injections HTML."},"properties":{},"ruleId":"semgrep.livraison-unsafe-html"},{"fingerprints":{"matchBasedId/v1":"requires login"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"tmp/baseline/security-helpers.ts","uriBaseId":"%SRCROOT%"},"region":{"endColumn":35,"endLine":49,"snippet":{"text":"export const SECRET = 'change-moi' // en production : variable d'environnement"},"startColumn":8,"startLine":49}}}],"message":{"text":"Une clé JWT/HMAC doit être injectée hors du dépôt et rotationnable."},"properties":{},"ruleId":"semgrep.livraison-hardcoded-jwt-secret"}],"tool":{"driver":{"name":"Semgrep OSS","rules":[{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"Une clé JWT/HMAC doit être injectée hors du dépôt et rotationnable."},"help":{"markdown":"Une clé JWT/HMAC doit être injectée hors du dépôt et rotationnable.","text":"Une clé JWT/HMAC doit être injectée hors du dépôt et rotationn